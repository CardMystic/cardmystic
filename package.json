{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nuxt build",
    "build:azure": "nuxi build --preset=azure",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --ext .ts,.js,.vue",
    "lint:fix": "eslint . --ext .ts,.js,.vue --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "update:card-oracle-ids": "node scripts/update-card-oracle-ids.mjs",
    "gen:types": "npx supabase gen types typescript --project-id ddbgietanhxrozzmogur > database.types.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@nuxt/ui": "^3.3.7",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-query-devtools": "^5.91.0",
    "dotenv": "^16.6.1",
    "mana-font": "^1.18.0",
    "marked": "^18.0.9",
    "node-emoji": "^2.2.0",
    "nuxt": "^3.21.11",
    "nuxt-vitalizer": "^0.10.0",
    "posthog-js": "^1.434.2",
    "sanitize-html": "^2.17.7",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.93",
    "@playwright/test": "^1.62.1",
    "@types/sanitize-html": "^2.16.1",
    "@vue/devtools-api": "6.6.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.100.0",
    "supabase": "^2.111.0",
    "typescript-eslint": "^8.66.0",
    "vite-plugin-devtools-json": "^0.4.1",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "vue-demi"
    ]
  }
}
